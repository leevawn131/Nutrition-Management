{
  "name": "nutrition-management",
  "version": "1.0.0",
  "private": true,
  "description": "Nutrition Management monorepo containing mobile, admin web, and backend applications.",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run mobile\"",
    "mobile": "cd frontend/mobile && npm start",
    "backend": "cd backend && node server.js",
    "admin": "cd frontend/admin && npm run dev",
    "build:admin": "cd frontend/admin && npm run build",
    "dev:all": "concurrently \"npm run backend\" \"npm run mobile\" \"npm run admin\""
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo": "^57.0.0"
  }
}
